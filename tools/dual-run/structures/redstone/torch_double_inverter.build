# From pumpkin:redstone_double_inverter_buffer.
# Two stacked torches. The lower one stands on START and must turn off, which
# unpowers the stone above it, so the upper torch turns on and powers ACCEPT.
# size: 3 6 3
fill ~ ~ ~ ~2 ~ ~2 stone
setblock ~1 ~1 ~1 test_block[mode=start]{mode:"start",message:""}
setblock ~1 ~2 ~1 redstone_torch
setblock ~1 ~3 ~1 stone
setblock ~1 ~4 ~1 redstone_torch
setblock ~1 ~5 ~1 test_block[mode=accept]{mode:"accept",message:""}
