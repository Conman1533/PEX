+
+    #[inline]
+    pub fn unset(&mut self, bit_index: usize) {
+        let byte = &mut self.data[bit_index / 8];
+        *byte &= !(1u8 << (bit_index % 8));
+    }
+
+    #[inline]
+    pub fn set_to(&mut self, bit_index: usize, value: bool) {
+        if value {
+            self.set(bit_index);
+        } else {
+            self.unset(bit_index);
+        }
+    }
+}
