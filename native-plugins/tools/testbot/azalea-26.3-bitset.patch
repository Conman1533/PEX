+// The 26.3 branch's special case: `#[var] FixedBitSet<32>` is encoded as a varint.
+impl AzBufVar for FixedBitSet<32> {
+    fn azalea_read_var(buf: &mut Cursor<&[u8]>) -> Result<Self, BufReadError> {
+        let bytes = u32::azalea_read_var(buf)?.to_be_bytes();
+        let mut set = Self::new();
+        for (slot, byte) in set.data.iter_mut().zip(bytes) {
+            *slot = byte;
+        }
+        Ok(set)
+    }
+    fn azalea_write_var(&self, buf: &mut impl Write) -> io::Result<()> {
+        let mut bytes = [0u8; 4];
+        for (slot, byte) in bytes.iter_mut().zip(self.data) {
+            *slot = byte;
+        }
+        u32::from_be_bytes(bytes).azalea_write_var(buf)
+    }
 }
 
